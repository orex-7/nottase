# Supabase — copie para .env e preencha com as chaves do seu projeto
# (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUA_ANON_KEY"

# URL pública do app (usada no redirect do OAuth). Em produção, troque.
# Para o app desktop (Electron), o build usa automaticamente
# http://localhost:4173 — não é necessário alterar aqui.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
